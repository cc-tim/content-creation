# LLM backend: default is "cli" — every pipeline LLM call runs through headless `claude -p` on
# Tim's Claude subscription. No API key needed; just run `claude login` on this machine once.
# PIPELINE_ANTHROPIC_API_KEY below is only needed when PIPELINE_LLM_BACKEND=api (opt-in).
# PIPELINE_LLM_BACKEND=api
# PIPELINE_ANTHROPIC_API_KEY=sk-ant-xxx

# Required for Discovery (not needed for MVP ad-hoc mode)
# PIPELINE_YOUTUBE_API_KEY=AIzaXxx

# Optional: premium TTS fallback
# PIPELINE_GOOGLE_CLOUD_TTS_KEY=xxx

# Output directory (default: ./output)
# PIPELINE_OUTPUT_DIR=./output

# Optional: stock photo/video gallery (free tiers)
# PEXELS_API_KEY=your_key_here
# PIXABAY_API_KEY=your_key_here
